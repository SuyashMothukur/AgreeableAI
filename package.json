{
  "name": "sentiment-alignment-study",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "concurrently -n api,ui -c blue,green \"npm run dev --prefix ./server\" \"npm run dev --prefix ./client\"",
    "dev": "npm start",
    "install:all": "npm install",
    "build": "npm run build --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
